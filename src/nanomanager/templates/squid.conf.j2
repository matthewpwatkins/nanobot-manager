# Nanomanager Squid Configuration
# Generated by nanomanager - do not edit manually

acl nanomanager_allowed_domains dstdomain "{{ allowlist_path }}"
acl SSL_ports port 443
acl CONNECT method CONNECT
acl localnet src 127.0.0.0/8

http_port 127.0.0.1:{{ proxy_port }}

# Allow CONNECT only to SSL ports
http_access deny CONNECT !SSL_ports

# Allow access to whitelisted domains only
http_access allow localnet nanomanager_allowed_domains
http_access allow localnet CONNECT nanomanager_allowed_domains

# Deny everything else
http_access deny all

# No caching of sensitive data
cache deny all
cache_mem 8 MB

# Logging
access_log /var/log/squid/nanomanager-access.log combined
cache_log /var/log/squid/nanomanager-cache.log

# Don't expose internal IPs
forwarded_for off
via off
