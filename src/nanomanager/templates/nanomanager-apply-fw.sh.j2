#!/bin/bash
# Nanomanager firewall rules for nanobot user (UID={{ nanobot_uid }})
# Generated by nanomanager - do not edit manually
set -euo pipefail

NANOBOT_UID={{ nanobot_uid }}
PROXY_PORT={{ proxy_port }}

flush_rules() {
    iptables -t filter -D OUTPUT -m owner --uid-owner "$NANOBOT_UID" -j nanobot_output 2>/dev/null || true
    iptables -t filter -F nanobot_output 2>/dev/null || true
    iptables -t filter -X nanobot_output 2>/dev/null || true
}

apply_rules() {
    # Create chain (or flush if exists)
    iptables -t filter -N nanobot_output 2>/dev/null || iptables -t filter -F nanobot_output

    # Allow loopback traffic (to reach squid at 127.0.0.1:$PROXY_PORT)
    iptables -t filter -A nanobot_output -o lo -j ACCEPT

    # Allow established/related connections
    iptables -t filter -A nanobot_output -m state --state ESTABLISHED,RELATED -j ACCEPT

    # Drop everything else outbound from nanobot UID
    iptables -t filter -A nanobot_output -j DROP

    # Jump to our chain for nanobot UID in OUTPUT
    iptables -t filter -I OUTPUT -m owner --uid-owner "$NANOBOT_UID" -j nanobot_output
}

case "${1:-apply}" in
    flush)
        flush_rules
        echo "Nanobot firewall rules flushed (UID=$NANOBOT_UID)."
        ;;
    apply|*)
        flush_rules
        apply_rules
        echo "Nanobot firewall rules applied (UID=$NANOBOT_UID)."
        ;;
esac
